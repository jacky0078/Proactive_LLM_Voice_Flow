[Unit]
Description=Edge proactive cockpit supervisor
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/opt/edge
Environment=OMP_NUM_THREADS=2
ExecStart=/usr/bin/python3 /opt/edge/sample/cockpit_supervisor.py --build-dir /opt/edge/build/rk-native --config /opt/edge/configs/cockpit-rk3588.json --output-dir /var/lib/edge-cockpit
Restart=no
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
